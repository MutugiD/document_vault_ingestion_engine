__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

build/
dist/
build-*/
dist-*/
*.spec.bak

# Bundled third-party runtimes are staged at build time by
# scripts/stage_tesseract_runtime.py, never committed: 80+ MB of binaries in
# git history is permanent, and the script is the reproducible artefact.
runtime/

.env
.env.*
!.env.example

*.log
*.tmp
*.bak

local-vault/
test-output/
release-output/
evidence/

# Vendor private keys (never commit)
_vendor/

# Android companion. `build/` above already covers android/app/build/.
# The signing keystore must never enter history: committed once, the app's
# signing identity has to be replaced. security_checks/scanner.py fails the
# build if one is tracked, so this and that rule are two halves of one guard.
*.jks
*.keystore
*.p12
*.pfx
android/local.properties
android/.gradle/
