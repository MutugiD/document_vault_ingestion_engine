/*
 * JurisNuru desktop stylesheet.
 *
 * Deep navy shell, white content cards, blue and teal actions. Matches the
 * product brief's license-gate and open-dashboard views.
 *
 * JurisNuru is an independent product. It records alongside the Judiciary
 * e-filing portal and is not affiliated with, or endorsed by, the Judiciary
 * of Kenya.
 *
 * Palette
 *   shell / gate      #0E1A2B    page surface      transparent (shell shows)
 *   sidebar           #152538    card              #FFFFFF
 *   card border       #E2E9F2    card hairline     #EEF3F9
 *   primary action    #1D6FB8    primary hover     #2A81CE
 *   secondary action  #0E9384    accent            #E8963C
 *   text              #16222F    muted text        #5F7186
 *   text on dark      #F2F6FB    muted on dark     #9DB2CC
 *
 * Status semantics -- one mapping, used everywhere, never colour alone:
 *   positive #0E7C66   attention #B4761B   negative #B3382C   neutral #5F7186
 *
 * Contrast is enforced by tests/validate_contrast.py, which measures rendered
 * pixels rather than reading this file. Two labels shipped invisible before it
 * existed, both because a rule assumed a surface colour that was not what Qt
 * actually painted. Change colours here, then run that test.
 */

/* ── Global ── */
QMainWindow,
QWidget#centralRoot {
    background-color: #0E1A2B;
}

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #16222F;
}

/* Type scale. Four sizes, used consistently, so hierarchy is legible before
 * anything is read. */
QLabel {
    color: #16222F;
    background: transparent;
}

QLabel#heading {
    font-size: 23px;
    font-weight: 700;
    color: #F2F6FB;
    padding: 6px 0px 2px 0px;
    background: transparent;
}

QLabel#subtitle {
    font-size: 12px;
    color: #9DB2CC;
    padding: 0px 0px 8px 0px;
    background: transparent;
}

QLabel#statusLabel {
    color: #9DB2CC;
    font-size: 12px;
    padding: 4px 2px;
}

/* ── License gate ── */
QScrollArea#licenseGate,
QScrollArea#licenseGate > QWidget > QWidget {
    background-color: #0E1A2B;
    border: none;
}

QWidget#licensePage {
    background-color: #0E1A2B;
}

QWidget#licensePage QLabel {
    color: #F2F6FB;
}

QWidget#licensePage QLabel#licensePageTitle {
    font-size: 31px;
    font-weight: 700;
    color: #FFFFFF;
    padding: 4px 0px;
}

QWidget#licensePage QLabel#licensePageSubtitle {
    font-size: 14px;
    color: #9DB2CC;
    padding: 0px 0px 18px 0px;
}

QFrame#licenseGroup {
    background-color: #152538;
    border: 1px solid #24384F;
    border-radius: 12px;
    padding: 20px;
}

QWidget#licensePage QLabel#licensePageSteps {
    color: #C3D2E3;
    font-size: 13px;
    background-color: #152538;
    border: 1px solid #24384F;
    border-left: 3px solid #1D6FB8;
    border-radius: 8px;
    padding: 14px 16px;
}

QWidget#licensePage QLabel#licenseFileNote {
    color: #8398B4;
    font-size: 11px;
    padding: 4px 2px;
}

QWidget#licensePage QPushButton#copyInstallationIdButton {
    background-color: transparent;
    border: 1px solid #334962;
    color: #B7C8DC;
    font-weight: 500;
    padding: 6px 12px;
}

QWidget#licensePage QPushButton#copyInstallationIdButton:hover {
    border: 1px solid #2A81CE;
    color: #FFFFFF;
}

QWidget#licensePage QLabel#licenseStatusLabel,
QWidget#licensePage QLabel#licenseInstallationLabel {
    color: #B7C8DC;
    font-size: 12px;
    padding: 2px 0px;
}

QWidget#licensePage QLineEdit {
    background-color: #0B1524;
    border: 1px solid #334962;
    border-radius: 6px;
    padding: 9px 12px;
    color: #FFFFFF;
    selection-background-color: #1D6FB8;
}

QWidget#licensePage QLineEdit:focus {
    border: 1px solid #2A81CE;
}

QWidget#licensePage QPushButton {
    background-color: #1D6FB8;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: 600;
}

QWidget#licensePage QPushButton:hover {
    background-color: #2A81CE;
}

QWidget#licensePage QPushButton:pressed {
    background-color: #175A96;
}

QWidget#licensePage QPushButton#browseLicenseButton {
    background-color: transparent;
    border: 1px solid #334962;
    color: #B7C8DC;
    font-weight: 500;
}

QWidget#licensePage QPushButton#browseLicenseButton:hover {
    border: 1px solid #2A81CE;
    color: #FFFFFF;
}

/* ── Workbench shell ── */
QWidget#workbench {
    background-color: #0E1A2B;
    border-radius: 12px;
}

/* ── Sidebar ── */
QFrame#sidebarFrame {
    background-color: #152538;
    border: none;
    border-right: 1px solid #1E304A;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

QLabel#sidebarBranding {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    padding: 16px 16px 2px 16px;
    background: transparent;
}

QLabel#sidebarSubtitle {
    font-size: 11px;
    color: #9DB2CC;
    padding: 0px 16px 18px 16px;
    background: transparent;
}

QPushButton#sidebarNavButton {
    background-color: transparent;
    color: #C3D2E3;
    border: none;
    border-radius: 8px;
    padding: 11px 14px;
    margin: 2px 10px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton#sidebarNavButton:hover {
    background-color: #1E3350;
    color: #FFFFFF;
}

QPushButton#sidebarNavButton:checked {
    background-color: #1D6FB8;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#sidebarNavButton:focus {
    border: 1px solid #6FA8DC;
}

QLabel#sidebarVersionLabel {
    font-size: 10px;
    color: #7E93AB;
    padding: 12px 16px;
    background: transparent;
}

/* ── Content area ──
 * The scroll area's viewport widget must be explicitly transparent. Left to
 * itself Qt paints it the default #EFEFEF, which is neither the navy shell nor
 * a white card -- and page headings styled for the shell then rendered nearly
 * invisible on it. That was a real shipped defect, twice.
 */
QTabWidget#workflowTabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#workflowTabs > QWidget {
    background: transparent;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QWidget#workspacePage,
QWidget#documentsPage,
QWidget#filingRecordPage,
QWidget#searchPage,
QWidget#reportsPage,
QWidget#settingsPage,
QWidget#dashboardPage,
QWidget#aboutPage {
    background: transparent;
}

/* ── Cards ──
 * Every group is a white surface on the navy shell. Adding a QFrame group
 * without adding it here leaves it transparent, so its form labels render dark
 * on dark -- which validate_contrast.py will fail on.
 */
QFrame#connectionGroup,
QFrame#setupGroup,
QFrame#vaultGroup,
QFrame#importGroup,
QFrame#searchGroup,
QFrame#aiKeysGroup,
QFrame#backupGroup,
QFrame#adminGroup,
QFrame#reportsGroup,
QFrame#dailyReminderGroup,
QFrame#remindersInboxGroup,
QFrame#remindersSendGroup,
QFrame#moduleCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E9F2;
    border-radius: 12px;
    padding: 18px;
}

QFrame#moduleCard {
    padding: 12px 14px;
}

QFrame#backendConnectionDialog {
    background-color: #FFFFFF;
    border: 1px solid #E2E9F2;
    border-radius: 12px;
    padding: 16px;
}

/* ── Matter workspace sub-tabs ── */
QTabWidget#matterWorkspaceTabs::pane {
    border: 1px solid #E2E9F2;
    background: #FFFFFF;
    border-radius: 10px;
}

QTabWidget#matterWorkspaceTabs QTabBar::tab {
    background: transparent;
    color: #9DB2CC;
    padding: 9px 14px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}

QTabWidget#matterWorkspaceTabs QTabBar::tab:hover {
    color: #FFFFFF;
}

QTabWidget#matterWorkspaceTabs QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #E8963C;
    font-weight: 600;
}

/* ── Inputs ── */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D3DEEA;
    border-radius: 6px;
    padding: 8px 10px;
    color: #16222F;
    selection-background-color: #1D6FB8;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #1D6FB8;
    padding: 7px 9px;
}

QLineEdit:disabled,
QTextEdit:disabled {
    background-color: #F1F5FA;
    color: #8A9AAC;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E9F2;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 6px;
    color: #16222F;
}

QListWidget::item:hover {
    background-color: #EEF4FB;
}

QListWidget::item:selected {
    background-color: #1D6FB8;
    color: #FFFFFF;
}

/* ── Buttons ── */
QPushButton {
    background-color: #1D6FB8;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #2A81CE;
}

QPushButton:pressed {
    background-color: #175A96;
}

/* A visible focus ring, so the application is usable from the keyboard. */
QPushButton:focus {
    border: 2px solid #0E1A2B;
    padding: 7px 14px;
}

QPushButton:disabled {
    background-color: #D8E2EE;
    color: #8A9AAC;
}

/* Secondary actions read as teal, per the brief's "AI context" affordance. */
QPushButton#runNativeWorkflowButton,
QPushButton#askRagButton,
QPushButton#summaryAddButton,
QPushButton#testDailyReminderButton {
    background-color: #0E9384;
}

QPushButton#runNativeWorkflowButton:hover,
QPushButton#askRagButton:hover,
QPushButton#summaryAddButton:hover,
QPushButton#testDailyReminderButton:hover {
    background-color: #12ABA0;
}

/* Low-emphasis actions stay quiet so the primary path is obvious. */
QPushButton#refreshMatterListButton,
QPushButton#refreshAuditLogButton,
QPushButton#exportCalendarButton,
QPushButton#browseLicenseButton,
QPushButton#selftestButton,
QPushButton#dailyReminderSnoozeButton,
QPushButton#dailyReminderDismissButton {
    background-color: transparent;
    color: #1D6FB8;
    border: 1px solid #B8CBDF;
    font-weight: 500;
}

QPushButton#refreshMatterListButton:hover,
QPushButton#refreshAuditLogButton:hover,
QPushButton#exportCalendarButton:hover,
QPushButton#selftestButton:hover,
QPushButton#dailyReminderSnoozeButton:hover,
QPushButton#dailyReminderDismissButton:hover {
    background-color: #EEF4FB;
    border: 1px solid #1D6FB8;
}

/* The footer buttons sit on the navy shell, outside any card. */
QPushButton#runSelftestButton {
    background-color: transparent;
    color: #C3D2E3;
    border: 1px solid #334962;
    font-weight: 500;
}

QPushButton#runSelftestButton:hover {
    border: 1px solid #2A81CE;
    color: #FFFFFF;
}

QCheckBox {
    color: #16222F;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #B8CBDF;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #1D6FB8;
    border: 1px solid #1D6FB8;
}

QCheckBox::indicator:focus {
    border: 2px solid #1D6FB8;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3A5271;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4E6B8F;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #3A5271;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Dialogs ──
 * A QDialog inherits the dark shell, but QLabel defaults to dark text, so form
 * labels rendered near-invisible. Dialogs are light surfaces: they are focused
 * data entry, not chrome.
 */
QDialog {
    background-color: #FFFFFF;
}

QDialog QLabel {
    color: #16222F;
    font-size: 13px;
}

QDialog QLineEdit,
QDialog QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D3DEEA;
    border-radius: 6px;
    padding: 8px 10px;
    color: #16222F;
    min-height: 18px;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus {
    border: 2px solid #1D6FB8;
    padding: 7px 9px;
}

QDialog QComboBox::drop-down {
    border: none;
    width: 22px;
}

QDialog QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #16222F;
    selection-background-color: #1D6FB8;
    selection-color: #FFFFFF;
    border: 1px solid #D3DEEA;
}

QDialog QLabel#dialogHint {
    color: #5F7186;
    font-size: 11px;
}

QDialog QLabel[error="true"] {
    color: #B3382C;
    font-size: 12px;
}

/* ── Daily reminder ── */
QDialog#dailyReminderDialog {
    background-color: #FFFFFF;
}

QLabel#dailyReminderHeading {
    font-size: 18px;
    font-weight: 700;
    color: #0E1A2B;
    padding: 2px 0px 4px 0px;
}

QLabel#dailyReminderSummaryLabel {
    font-size: 13px;
    font-weight: 600;
    color: #1D6FB8;
    padding: 0px 0px 8px 0px;
}

QLabel#dailyReminderSettingsHeading {
    font-size: 16px;
    font-weight: 600;
    color: #0E1A2B;
    padding: 0px 0px 6px 0px;
}

QLabel#dailyReminderCaption {
    color: #5F7186;
    font-size: 11px;
    padding: 6px 0px 0px 0px;
}

/* ── Page headings, on the navy shell ──
 * These sit outside the white cards, so they need light text. Verified by
 * rendered pixels, not by reading this rule: the surface behind them was
 * silently #EFEFEF until the scroll-area viewport was made transparent above,
 * and light-on-light is just as invisible as dark-on-dark.
 */
QWidget#filingRecordPage > QLabel,
QWidget#reportsPage > QLabel,
QWidget#documentsPage > QLabel,
QWidget#searchPage > QLabel,
QWidget#remindersPage > QLabel,
QWidget#workspacePage > QLabel,
QWidget#settingsPage > QLabel,
QLabel#filingRecordGroupLabel,
QLabel#filingRecordCaption {
    color: #F2F6FB;
}

/* searchGroupLabel is inside the white search card, not on the shell. Grouping
 * it with the shell headings by name looked right and rendered light-on-light. */
QLabel#searchGroupLabel {
    font-size: 17px;
    font-weight: 600;
    color: #0E1A2B;
}

QLabel#filingRecordCaption {
    color: #B7C8DC;
    font-size: 12px;
}

QLabel#filingRecordMatterLabel {
    color: #F2F6FB;
    font-size: 13px;
    font-weight: 600;
    padding: 2px 0px 6px 0px;
}

QLabel#filingRecordGroupLabel {
    font-size: 17px;
    font-weight: 600;
}

QLabel#roleStatusLabel,
QLabel#connectionHealthLabel {
    color: #B7C8DC;
}

QLabel#remindersHeading {
    font-size: 20px;
    font-weight: 700;
}

QLabel#remindersCaption {
    color: #B7C8DC;
    font-size: 12px;
    padding: 0px 0px 8px 0px;
}

/* Inside the white cards, so dark. */
QLabel#remindersInboxHeading,
QLabel#remindersSendHeading,
QLabel#remindersSentHeading {
    font-size: 15px;
    font-weight: 600;
    color: #0E1A2B;
    padding: 0px 0px 6px 0px;
}

/* An empty list should say what would fill it, not sit there blank. */
QLabel#remindersInboxEmptyLabel {
    color: #5F7186;
    font-size: 12px;
    padding: 6px 2px;
}

/* ── Trusted AI layer, beside the matter (brief slide 14) ── */
QFrame#matterAiPanel {
    background-color: #152538;
    border: 1px solid #24384F;
    border-radius: 12px;
    padding: 16px;
}

QFrame#matterAiPanel QLabel {
    color: #C3D2E3;
}

QLabel#matterAiHeading {
    font-size: 15px;
    font-weight: 700;
    color: #E8963C;
}

QLabel#matterAiCaption {
    font-size: 12px;
    color: #9DB2CC;
}

QLabel#matterAiSourcesLabel {
    font-size: 11px;
    color: #35C6B5;
    font-weight: 600;
}

QLabel#matterAiReviewLabel {
    font-size: 11px;
    font-weight: 600;
    color: #E8963C;
}

QFrame#matterAiPanel QTextEdit {
    background-color: #0B1524;
    border: 1px solid #334962;
    color: #F2F6FB;
}

QFrame#matterAiPanel QPushButton {
    background-color: #0E9384;
}

QFrame#matterAiPanel QPushButton:hover {
    background-color: #12ABA0;
}

QFrame#matterAiPanel QPushButton:disabled {
    background-color: #24384F;
    color: #8398B4;
}
